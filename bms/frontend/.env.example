# bms/frontend/.env.example

# Enable the new Central Auth Logic
VITE_USE_CENTRAL_AUTH=true

# URL of the Auth Service (Port 8001)
VITE_AUTH_URL=http://localhost:8001

# URL of the BMS Backend API (Port 8000)
# Note: Ensure /api is appended if your axios setup expects it, or remove if axios adds it. 
# Your budgetAPI.js has baseURL: .../api, so let's match that convention.
VITE_API_URL=http://localhost:8000/api