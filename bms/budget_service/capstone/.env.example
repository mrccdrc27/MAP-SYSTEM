# bms/budget_service/capstone/.env.example

# --- CORE SETTINGS ---
DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-12345
# Leave COOKIE_DOMAIN empty for localhost development!
COOKIE_DOMAIN=
ALLOWED_HOSTS=localhost,127.0.0.1,budget_service

# --- AUTHENTICATION ---
# Point to Local Auth Service (Port 8001 via Docker)
AUTH_SERVICE_URL=http://localhost:8001
# MUST match the key in auth/.env
DJANGO_JWT_SIGNING_KEY=super-secret-shared-key-12345

# --- DATABASE (Docker default) ---
DATABASE_URL=postgres://postgres:a4d@budget_db:5432/budgetpro_db
# If running manually without Docker, use:
# DATABASE_URL=postgres://postgres:a4d@localhost:5432/budgetpro_db

# --- CORS & CSRF (Allow Frontend) ---
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- EXTERNAL SERVICES (Mock Keys) ---
# These keys don't need to be real for local UI testing
API_KEY_FOR_BMS_TO_CALL_DTS=mock-dts-key
API_KEY_FOR_BMS_TO_CALL_AMS=mock-ams-key
API_KEY_FOR_BMS_TO_CALL_HDTS=mock-hdts-key
DTS_STATUS_UPDATE_ENDPOINT_URL=http://localhost:9000/mock/dts
AMS_STATUS_UPDATE_ENDPOINT_URL=http://localhost:9000/mock/ams
HDTS_STATUS_UPDATE_ENDPOINT_URL=http://localhost:9000/mock/hdts

# Incoming Keys (Keys other services use to call BMS)
DTS_CLIENT_API_KEY=dts-secure-key-12345
AMS_CLIENT_API_KEY=ams-secure-key-12345

# --- EMAIL (Console Backend for Dev) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=admin@localhost

# --- FRONTEND URL ---
FRONTEND_URL=http://localhost:5173