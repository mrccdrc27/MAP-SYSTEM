# Auth Service Environment Configuration

# Django
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=secret-key-1234
# DJANGO_JWT_SIGNING_KEY=your-jwt-signing-key-change-in-production
# CRITICAL: Must match bms/budget_service/.env.docker
DJANGO_JWT_SIGNING_KEY=super-secret-shared-key-12345
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,auth_service

# --- DATABASE ---
# Note: 'auth_db' is the container name in bms/docker-compose.yml
DATABASE_URL=postgresql://postgres:a4d@auth_db:5432/budgetpro_auth
PGHOST=auth_db
PGPORT=5432
POSTGRES_DB=budgetpro_auth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=a4d

# Email
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=your-email@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-app-password
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Frontend & Cookies
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# CORS & Security
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# System URLs
TTS_SYSTEM_URL=http://localhost:1000/
AMS_SYSTEM_URL=http://localhost:3000/ams
HDTS_SYSTEM_URL=http://localhost:3000/hdts
BMS_SYSTEM_URL=http://localhost:5173/
DEFAULT_SYSTEM_URL=http://localhost:5173/dashboard

# Celery
DJANGO_CELERY_BROKER_URL=amqp://admin:admin@localhost:5672/

# SendGrid Email Configuration (replaces Gmail API)
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=TicketFlow
SENDGRID_ENABLED=True
SUPPORT_EMAIL=support@ticketflow.com

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# Set to False to bypass reCAPTCHA validation (useful for development/testing)
# --- EXTRAS ---
RECAPTCHA_ENABLED=False

